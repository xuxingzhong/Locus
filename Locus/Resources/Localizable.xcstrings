{
  "sourceLanguage": "en",
  "strings": {
    "Real location for recovery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于恢复的真实位置"
          }
        }
      }
    },
    "Not saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存"
          }
        }
      }
    },
    "Automatically captured": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动采集"
          }
        }
      }
    },
    "Manually selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动选择"
          }
        }
      }
    },
    "Expired snapshot — choose a location or recapture": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动快照已过期，请重新获取或手动修改"
          }
        }
      }
    },
    "Usable for nearby restore": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用于附近过渡恢复"
          }
        }
      }
    },
    "Not yet trusted for nearby restore": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可用的可信位置"
          }
        }
      }
    },
    "Search or edit real location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索或修改真实位置"
          }
        }
      }
    },
    "Capture current real position": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新获取当前位置"
          }
        }
      }
    },
    "Capturing precise location…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取精确位置…"
          }
        }
      }
    },
    "Use nearby transition before restoring": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前先过渡到保存位置附近"
          }
        }
      }
    },
    "Auto-capture requires a fresh, precise, non-simulated position before spoofing. Search to edit the place name and coordinate together. A manual location stays until changed; update it after travelling.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始虚拟定位前自动采集新鲜的精确非模拟位置；可通过搜索同时修改地点名称和实际坐标。手动位置会一直保留，外出后请及时更新。"
          }
        }
      }
    },
    "Precise Location is required to capture a real position.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要开启“精确位置”才能自动采集真实位置。"
          }
        }
      }
    },
    "Enable location access in iOS Settings or choose an address manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iOS 设置中开启定位权限，或手动搜索选择地址。"
          }
        }
      }
    },
    "Current position (resolving address…)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前位置（正在解析地址…）"
          }
        }
      }
    },
    "Search for a place or address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入地点或地址"
          }
        }
      }
    },
    "Search places": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索地点"
          }
        }
      }
    },
    "Search and select a real place. Its name is editable, but the coordinate comes from the selected result.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索并选择真实地点。名称可以编辑，实际坐标以所选搜索结果为准。"
          }
        }
      }
    },
    "Matching places": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索结果"
          }
        }
      }
    },
    "Unnamed place": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名地点"
          }
        }
      }
    },
    "Selected recovery location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择的位置"
          }
        }
      }
    },
    "Display name": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示名称"
          }
        }
      }
    },
    "Save recovery location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存真实位置"
          }
        }
      }
    },
    "This manually selected place will be used as a nearby transition before clearing simulation. Update it if you travel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复定位前将先过渡到此处附近，随后清除模拟。移动到其他地区后请重新设置。"
          }
        }
      }
    },
    "Edit real location": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改真实位置"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "No matching places found. Try a more complete address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到匹配的地点，请输入更完整的地址。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
